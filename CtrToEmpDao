package com.camp.bwac.dao.bwac.ctrToEmp;

import com.camp.bwac.common.CtrToEmpVO;
import com.camp.bwac.bwac.worker.TerminateWorkerVO;
import com.camp.bwac.util.constants.bwacConstants;
import com.camp.bwac.util.rowMappers.CtrToEmpMapper;
import com.camp.bwac.util.rowMappers.NaturalExpirationTerminationMapper;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.jdbc.core.namedparam.MapSqlParameterSource;
import org.springframework.jdbc.core.namedparam.NamedParameterJdbcTemplate;
import org.springframework.stereotype.Service;

import java.util.List;

@Service
public class CtrToEmpDao {
    @Autowired
    @Qualifier("bwacNamedJbcTemplate")
    private NamedParameterJdbcTemplate namedParameterJdbcTemplate;
    public List<CtrToEmpVO> getCtrToDaoList(boolean isTempWorker)
    {
        String query="";
                if(isTempWorker)
                    query= bwacConstants.CTR_TO_EMP_TEMP_WORKER;
                else
                    query=bwacConstants.CTR_TO_EMP;
        List<CtrToEmpVO> ctrToEmpVOS = namedParameterJdbcTemplate.query(query,
                (new MapSqlParameterSource()), new CtrToEmpMapper());

        return ctrToEmpVOS;
    }
}
